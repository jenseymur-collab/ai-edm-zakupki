# Файл-шаблон переменных окружения.
# Скопируй в .env и заполни своими значениями:
#   cp .env.example .env

# === OpenRouter API ===
# Ключ берётся в личном кабинете: openrouter.ai → Settings → API Keys
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === Модели LLM ===
LLM_MODEL_EXTRACTION=anthropic/claude-sonnet-4-5
LLM_MODEL_SEARCH=anthropic/claude-sonnet-4-5
LLM_MODEL_DELAYS=anthropic/claude-sonnet-4-5
LLM_MODEL_AUDIT=anthropic/claude-sonnet-4-5
LLM_MODEL_COMPARISON=anthropic/claude-opus-4-6
LLM_MODEL_EMBEDDINGS=openai/text-embedding-3-small

# === База данных ===
# Локальный Postgres внутри docker-compose. Менять не нужно.
DATABASE_URL=postgresql+asyncpg://edm:edm@postgres:5432/edm

# === Окружение ===
ENV=development
LOG_LEVEL=INFO
